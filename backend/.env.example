# Get a free key at https://newsapi.org/register (100 requests/day on free tier)
NEWS_API_KEY=your_newsapi_key_here

# Optional: comma-separated list of trusted domains NewsAPI should search across.
# Leave blank to let NewsAPI search everything it indexes.
TRUSTED_DOMAINS=reuters.com,apnews.com,bbc.com,ndtv.com,thehindu.com,indianexpress.com,timesofindia.indiatimes.com

# Similarity thresholds (0-1). Tune these as you collect real examples.
THRESHOLD_VERY_LIKELY=0.90
THRESHOLD_MAYBE=0.75
THRESHOLD_RELATED=0.50
